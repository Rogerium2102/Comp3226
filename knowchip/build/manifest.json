{
  "manifest_version": 3,
  "name": "knowchip",
  "version": "0.67",
  "description": "Cookie Managing Extension",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "cookies",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}