{
  "name": "knowchip-cookie-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local HTTPS cookie fixtures for KnowChip tasks 1.4.1–1.4.3",
  "engines": { "node": ">=22" },
  "scripts": {
    "cert": "node scripts/certificates.js",
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": { "@playwright/test": "1.65.1" }
}
