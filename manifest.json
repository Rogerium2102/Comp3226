{
  "manifest_version": 3,
  "name": "Template",
  "version": "0.1",
  "description": "Minimal Chrome extension",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background" : {"service_worker":  "background.js"}
}